window-rule {
    match app-id="dropdown-term"
    open-floating true
    open-focused true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.333; }
    default-floating-position x=0 y=5 relative-to="top"
    //opacity 0.8

    //background-effect {
    //    blur true
    //    xray false
    //}
}
